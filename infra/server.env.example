# Settings for infra/bootstrap.sh and infra/verify.sh.
#
#   1. Copy this file to infra/server.env (it is ignored by git) and edit it.
#   2. On the server, as root:  bash infra/bootstrap.sh
#   3. Then:                    bash infra/verify.sh
#
# Format: KEY=value, one per line, no spaces around the = and no trailing comments.
# Lines that start with # are comments. This file is read, never executed.

# The public domain, without "www." and without https://. The server answers on
# www.<domain>, cms.<domain>, staging.<domain> and cms-staging.<domain>.
OC_DOMAIN=example.com

# Named administrators, comma-separated, each as name:path-to-public-key.
# One person, one key. Use the .pub file, never a private key. A relative path is read
# from this file's folder. These users are the only ones who may sign in over SSH. Each is
# created with sudo, and ~/.ssh/authorized_keys is set to exactly this key.
# Example: OC_ADMINS=alice:keys/alice.pub,bob:keys/bob.pub
OC_ADMINS=alice:keys/alice.pub

# The deploy account (spec 5 and 10.9): the one door CI uses to ship images to this server.
# It is a system user, "oc-deploy", with no password, no way to open a shell, one SSH key PER
# ENVIRONMENT (each key can run one forced command that names its environment, so a staging key can
# never deploy production), one sudo rule, and nothing it can read or write but a spool folder.
# yes: create it. For every environment in OC_ENVS the matching setting below is then required:
#      the path to that environment's PUBLIC key (a .pub file, never a private key; a relative path
#      is read from this file's folder). Make a separate key pair for each environment, for CI only
#      (ssh-keygen -t ed25519 -f deploy_key_prod -N "", and the same for staging). Keep each private
#      half in the secret DEPLOY_SSH_KEY of the matching GitHub ENVIRONMENT (not a repository secret)
#      and delete it from your machine. No key may be an admin's key, and no two may be the same.
# no:  no deploy account at all (an existing one is removed). Deploy by hand instead.
OC_DEPLOY_ENABLED=yes
OC_DEPLOY_PUBKEY_PROD=keys/deploy-prod.pub
OC_DEPLOY_PUBKEY_STAGING=keys/deploy-staging.pub
# The largest image tarball CI may upload, in bytes (2147483648 = 2 GiB; at most 64 GiB).
OC_DEPLOY_MAX_BYTES=2147483648
#
# NOTE for the first deploy: the two containers of each environment name the placeholder image
# "bootstrap", which does not exist, and their Quadlet files say Pull=never. So oc-cms-<env> and
# oc-web-<env> fail at every boot (and every start) until the first deploy has loaded real
# images and pointed them at the new tag. That is expected, not a fault.

# The SSH port. Must not be 22. The firewall opens only this port (plus 80 and 443 for
# Cloudflare). Before you close your first session, open a second terminal and check that
# you can sign in on this port.
OC_SSH_PORT=2222

# The server's time zone. Moments are stored in UTC and shown in this zone.
OC_TIMEZONE=Africa/Lagos

# Environments on this server, space-separated: prod, staging, or both.
OC_ENVS=prod staging

# yes: admins can use sudo without a password (they have none; they sign in by key).
# no: sudo asks for a password. Every admin must already have one (run "passwd <name>"
# as root first); the bootstrap refuses to continue otherwise, so nobody is locked out.
OC_SUDO_PASSWORDLESS=yes

# Size of the swap file, created only if the server has no swap yet.
OC_SWAP_SIZE=2G
