# Managed by infra/bootstrap.sh, rendered from infra/nginx/oc.conf.template. Do not edit.
# Ubuntu's nginx.conf includes this file inside its http { } block.
#
# What this does:
#  - the four Node apps listen on localhost only; this is the only way in;
#  - a request must present Cloudflare's client certificate (Authenticated Origin Pulls),
#    so a request that reaches the server's IP directly is refused;
#  - TLS 1.2 or newer, no version banner, request size and time limits;
#  - /transfer/ and /media/ go to the right app, dotfiles are denied.

server_tokens off;
client_max_body_size 30m;
client_header_timeout 15s;
client_body_timeout 30s;
send_timeout 30s;
keepalive_timeout 30s;
reset_timedout_connection on;
client_header_buffer_size 2k;
large_client_header_buffers 4 8k;

# Upload and download tokens travel in the URL path, so they are kept out of the logs.
map $request_uri $oc_logged_uri {
    default $request_uri;
    ~^(?<oc_path_prefix>/transfer/[a-z]+/) "${oc_path_prefix}[token]";
}

log_format oc '$remote_addr - [$time_local] "$request_method $oc_logged_uri $server_protocol" '
              '$status $body_bytes_sent "$http_referer" "$http_user_agent" rt=$request_time';

@@BEGIN env@@
# ===== environment: @@ENV@@ =====
upstream oc_web_@@ENV@@ {
    server 127.0.0.1:@@WEB_PORT@@;
    keepalive 16;
}

upstream oc_cms_@@ENV@@ {
    server 127.0.0.1:@@CMS_PORT@@;
    keepalive 16;
}

# Plain HTTP. The firewall lets only Cloudflare reach this port; send the browser to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name @@WEB_HOST@@ @@CMS_HOST@@;
    return 301 https://$host$request_uri;
}

# @@WEB_HOST@@ -> Astro on 127.0.0.1:@@WEB_PORT@@
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@WEB_HOST@@;

    ssl_certificate           /etc/ssl/oc/origin.pem;
    ssl_certificate_key       /etc/ssl/oc/origin.key;
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:oc_tls:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Authenticated Origin Pulls: only Cloudflare holds a certificate signed by this CA.
    ssl_client_certificate    /etc/nginx/oc/cloudflare-origin-pull-ca.pem;
    ssl_verify_client         on;
    ssl_verify_depth          1;

    access_log /var/log/nginx/oc-@@ENV@@-web.access.log oc;
    error_log  /var/log/nginx/oc-@@ENV@@-web.error.log warn;

    @@WEB_ROBOTS@@

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_hide_header X-Powered-By;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Dotfiles (.git, .env and friends) are never served. /.well-known/ stays reachable.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Public media, served by the web app from the media folder.
    location /media/ {
        proxy_pass http://oc_web_@@ENV@@;
    }

    location / {
        proxy_pass http://oc_web_@@ENV@@;
    }
}

# @@CMS_HOST@@ -> Strapi on 127.0.0.1:@@CMS_PORT@@
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@CMS_HOST@@;

    ssl_certificate           /etc/ssl/oc/origin.pem;
    ssl_certificate_key       /etc/ssl/oc/origin.key;
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:oc_tls:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    ssl_client_certificate    /etc/nginx/oc/cloudflare-origin-pull-ca.pem;
    ssl_verify_client         on;
    ssl_verify_depth          1;

    access_log /var/log/nginx/oc-@@ENV@@-cms.access.log oc;
    error_log  /var/log/nginx/oc-@@ENV@@-cms.error.log warn;

    # The CMS is never meant to be indexed.
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_hide_header X-Powered-By;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Browsers upload (5 MB chunks) and download files here with short-lived signed
    # tokens. Slow connections get a longer body timeout, and nothing is buffered to disk.
    location /transfer/ {
        client_max_body_size 30m;
        client_body_timeout 120s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_pass http://oc_cms_@@ENV@@;
    }

    # The admin's thumbnails load from the same media folder.
    location /media/ {
        proxy_pass http://oc_cms_@@ENV@@;
    }

    location / {
        proxy_pass http://oc_cms_@@ENV@@;
    }
}

@@END env@@
# ===== anything else: refused =====
# A request for a host name this file does not know gets no answer on port 80 and no TLS
# handshake on port 443.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
}
