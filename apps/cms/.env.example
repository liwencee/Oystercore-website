# Copy to .env and replace every value. Real values never go in git.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS is a comma-separated list of at least two keys.

# Database (MariaDB 11.4 or MySQL 8). Local: docker compose -f docker-compose.dev.yml up -d
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=oc_dev
DATABASE_USERNAME=change-me
DATABASE_PASSWORD=change-me

# Strapi secrets
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Shared secret that the web app sends in the x-oc-secret header (must match apps/web)
OC_INTERNAL_SECRET=change-me

# Folder for uploaded media, outside the deploy folders (production: ~/oc-data)
OC_DATA_DIR=./.tmp/oc-data
