# Copy to .env and replace every value. Real values never go in git.

# Where the Strapi CMS is reachable from the web server, and the read-only API token for it
OC_CMS_URL=http://localhost:1337
OC_CMS_API_TOKEN=change-me

# Shared secret sent to the CMS in the x-oc-secret header (must match apps/cms)
OC_INTERNAL_SECRET=change-me

# Folder for uploaded media, outside the deploy folders (production: ~/oc-data)
OC_DATA_DIR=./.tmp/oc-data

# Content-Security-Policy mode: report-only or enforce
CSP_MODE=report-only

# Public origin of this site, used for canonical links and the sitemap
PUBLIC_SITE_URL=http://localhost:4321
